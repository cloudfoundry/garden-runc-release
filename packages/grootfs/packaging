#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${BOSH_INSTALL_TARGET}/src"
mv * "${BOSH_INSTALL_TARGET}/src"
mv "${BOSH_INSTALL_TARGET}/src" .

source /var/vcap/packages/golang-*-linux/bosh/compile.env

mkdir -p "${BOSH_INSTALL_TARGET}/bin"
export GOBIN="${BOSH_INSTALL_TARGET}/bin"

pushd src/code.cloudfoundry.org
  go install -tags cloudfoundry code.cloudfoundry.org/guardian/grootfs
  go install -tags cloudfoundry code.cloudfoundry.org/guardian/grootfs/store/filesystems/overlayxfs/tardis
  chmod u+s "${BOSH_INSTALL_TARGET}/bin/tardis"
popd
